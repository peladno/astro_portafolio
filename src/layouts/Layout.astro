---
import '../index.css';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang='en'>
  <head>
    <meta charset='UTF-8' />
    <meta name='viewport' content='width=device-width' />
    <link rel='icon' type='image/svg+xml' href='/favicon.svg' />
    <meta name='generator' content={Astro.generator} />
    <title>{title}</title>
    <link
      href='https://fonts.googleapis.com/css2?family=Inter:wght@200;300;400;500;600&family=Noto+Sans+JP:wght@300;400;500;600;700&family=Noto+Serif+JP:wght@400;600;700&family=Playfair+Display:ital,wght@0,400;1,400&display=swap'
      rel='stylesheet'
    />
    <link
      href='https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap'
      rel='stylesheet'
    />
    <script is:inline>
      (function () {
        const savedLang = localStorage.getItem('portfolio_lang');
        if (savedLang === 'ja' || savedLang === 'en') {
          document.documentElement.lang = savedLang;
        } else if (navigator.language && navigator.language.startsWith('ja')) {
          document.documentElement.lang = 'ja';
        } else {
          document.documentElement.lang = 'en';
        }

        const savedTheme = localStorage.getItem('portfolio_theme');
        const prefersDark = window.matchMedia(
          '(prefers-color-scheme: dark)',
        ).matches;
        if (savedTheme === 'dark' || (!savedTheme && prefersDark)) {
          document.documentElement.classList.add('dark');
        } else {
          document.documentElement.classList.remove('dark');
        }
      })();
    </script>
  </head>
  <body
    class='bg-[#f8f6f6] dark:bg-[#121111] text-[#2d2a2a] dark:text-[#f3eded] selection:bg-[#bf3a2b]/30 dark:selection:bg-[#e05343]/30 selection:text-white antialiased transition-colors duration-300'
  >
    <!-- Vertical Guide Line -->
    <div
      class='fixed left-8 md:left-16 top-0 bottom-0 w-px bg-[#bf3a2b]/20 dark:bg-[#e05343]/20 hidden md:block z-0 pointer-events-none'
    >
      <div
        class='absolute top-0 left-0 w-full h-1/4 bg-[#bf3a2b] dark:bg-[#e05343]'
      >
      </div>
    </div>

    <slot />

    <style is:global>
      :root {
        --font-sans:
          'Inter', 'Noto Sans JP', -apple-system, BlinkMacSystemFont,
          'Segoe UI', Roboto, 'Hiragino Sans', 'Noto Sans CJK JP', sans-serif;
        --font-serif:
          'Playfair Display', 'Noto Serif JP', 'Yu Mincho',
          'Hiragino Mincho ProN', serif;
      }

      html {
        scroll-behavior: smooth;
        font-family: var(--font-sans);
        font-feature-settings: 'palt' 1;
      }

      body {
        font-family: var(--font-sans);
      }

      a {
        text-decoration: none;
        color: inherit;
      }

      ul,
      li {
        list-style-type: none;
      }

      /* Language Visibility Rules */
      html[lang='en'] .lang-ja {
        display: none !important;
      }
      html[lang='ja'] .lang-en {
        display: none !important;
      }

      /* Standardize typography spacing across languages */
      html[lang='ja'] .lang-ja {
        letter-spacing: 0.03em !important;
        word-break: auto-phrase;
        line-break: strict;
      }

      .serif-thin {
        font-family: var(--font-serif);
        font-weight: 400;
      }
      .vertical-text {
        writing-mode: vertical-rl;
        text-orientation: mixed;
      }
      .hanko {
        border: 1.5px solid #bf3a2b;
        color: #bf3a2b;
        padding: 5px 12px;
        font-weight: 600;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        letter-spacing: 0.18em;
        line-height: 1;
        background: rgba(191, 58, 43, 0.04);
        transition:
          border-color 0.3s,
          color 0.3s,
          background-color 0.3s;
      }
      .hanko-large {
        min-width: 52px;
        padding: 8px 16px;
        border: 2px solid #bf3a2b;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        color: #bf3a2b;
        letter-spacing: 0.25em;
        position: relative;
        background: rgba(191, 58, 43, 0.05);
        transition:
          border-color 0.3s,
          color 0.3s,
          background-color 0.3s;
      }
      .dark .hanko {
        border-color: #e05343;
        color: #e05343;
        background: rgba(224, 83, 67, 0.12);
      }
      .dark .hanko-large {
        border-color: #e05343;
        color: #e05343;
        background: rgba(224, 83, 67, 0.12);
      }
      .timeline-line {
        width: 1px;
        background: linear-gradient(
          to bottom,
          transparent,
          #bf3a2b 10%,
          #bf3a2b 90%,
          transparent
        );
        opacity: 0.2;
      }
      .dark .timeline-line {
        background: linear-gradient(
          to bottom,
          transparent,
          #e05343 10%,
          #e05343 90%,
          transparent
        );
        opacity: 0.35;
      }
    </style>
  </body>
</html>
