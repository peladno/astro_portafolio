---
import { translations } from '../i18n/translations';
const { footer } = translations;
---

<footer
  class='px-6 md:px-24 py-12 border-t border-[#8c8484]/5 dark:border-white/5 flex flex-col md:flex-row justify-between items-center text-[10px] tracking-widest uppercase min-h-20 transition-colors duration-300'
>
  <div
    class='min-h-5 flex items-center text-[#5a5252] dark:text-[#a89f9f] font-medium'
  >
    <span class='lang-en'>{footer.copyright.en}</span>
    <span class='lang-ja'>{footer.copyright.ja}</span>
  </div>
  <div class='flex space-x-8 mt-4 md:mt-0 items-center'>
    <a
      class='footer-link py-1'
      href='https://github.com/peladno'
      target='_blank'
      rel='noopener noreferrer'>{footer.github}</a
    >
    <a
      class='footer-link py-1'
      href='https://www.linkedin.com/in/javier-perez-u/'
      target='_blank'
      rel='noopener noreferrer'>{footer.linkedin}</a
    >
    <a
      class='lang-en footer-link py-1'
      href='/JavierCurriculum.pdf'
      target='_blank'
      rel='noopener noreferrer'
    >
      <span>{footer.cv.en}</span>
    </a>
    <a
      class='lang-ja footer-link py-1'
      href='/JavierCurriculum.pdf'
      target='_blank'
      rel='noopener noreferrer'
    >
      <span>{footer.cv.ja}</span>
    </a>
  </div>
</footer>

<style>
  .footer-link {
    color: #5a5252;
    text-decoration: none;
    transition:
      color 0.2s ease,
      transform 0.2s ease;
    cursor: pointer;
    display: inline-block;
  }

  :global(.dark) .footer-link {
    color: #a89f9f;
  }

  .footer-link:hover,
  .footer-link:focus,
  .footer-link:active {
    color: #bf3a2b !important;
  }

  :global(.dark) .footer-link:hover,
  :global(.dark) .footer-link:focus,
  :global(.dark) .footer-link:active {
    color: #e05343 !important;
  }
</style>
