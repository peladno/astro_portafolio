---
import { translations } from '../i18n/translations';
const { experience } = translations;
---

<section
  class='max-w-4xl mx-auto py-24 border-t border-[#8c8484]/10'
  id='experience'
>
  <div
    class='flex flex-col md:flex-row md:items-end justify-between gap-8 mb-24'
  >
    <div>
      <h2
        class='text-xs tracking-[0.4em] uppercase text-[#bf3a2b] font-bold mb-4 flex items-center'
      >
        <span class='mr-4'>{experience.sectionNum}</span>
        <span class='lang-en'>{experience.sectionTitle.en}</span>
        <span class='lang-ja'>{experience.sectionTitle.ja}</span>
      </h2>
      <p class='text-[#5a5252] font-normal italic text-sm'>
        <span class='lang-en'>{experience.subtitle.en}</span>
        <span class='lang-ja'>{experience.subtitle.ja}</span>
      </p>
    </div>
  </div>
  <div class='relative'>
    <!-- Central Vertical Line -->
    <div
      class='absolute left-0 md:left-1/2 top-0 bottom-0 timeline-line transform md:-translate-x-1/2'
    >
    </div>
    <div class='space-y-24'>
      {
        experience.items.map((item, index) => {
          const isEven = index % 2 === 0;
          return (
            <div
              class:list={[
                'relative flex flex-col items-start md:items-start',
                isEven ? 'md:flex-row' : 'md:flex-row-reverse',
              ]}
            >
              <div
                class:list={[
                  'hidden md:block w-1/2 pt-1.5',
                  isEven ? 'pr-12 text-right' : 'pl-12 text-left',
                ]}
              >
                <span class='text-[10px] font-bold tracking-widest text-[#bf3a2b] uppercase'>
                  <span class='lang-en'>{item.periodEn}</span>
                  <span class='lang-ja'>{item.periodJa}</span>
                </span>
              </div>

              <div class='absolute left-0 md:left-1/2 top-2 w-3 h-3 bg-[#bf3a2b] rounded-full transform -translate-x-1/2 z-10 border-4 border-[#f8f6f6]' />

              <div
                class:list={[
                  'w-full md:w-1/2 pl-8',
                  isEven ? 'md:pl-12' : 'md:pl-0 md:pr-12 md:text-right',
                ]}
              >
                <span class='md:hidden block text-[10px] font-bold tracking-widest text-[#bf3a2b] uppercase mb-2'>
                  <span class='lang-en'>{item.periodEn}</span>
                  <span class='lang-ja'>{item.periodJa}</span>
                </span>

                <h3
                  class='text-xl serif-thin mb-1 min-h-[1.75rem] flex items-center text-[#2d2a2a]'
                  class:list={[!isEven && 'md:justify-end']}
                >
                  <span class='lang-en'>{item.titleEn}</span>
                  <span class='lang-ja'>{item.titleJa}</span>
                </h3>

                <p
                  class='text-[#5a5252] text-xs mb-4 uppercase tracking-widest min-h-[1.25rem] flex items-center font-medium'
                  class:list={[!isEven && 'md:justify-end']}
                >
                  <span class='lang-en'>{item.organizationEn}</span>
                  <span class='lang-ja'>{item.organizationJa}</span>
                </p>

                <!-- English Bullets -->
                <ul class='lang-en space-y-3 text-sm font-normal leading-relaxed text-[#5a5252]'>
                  {item.bulletsEn.map((bullet) => (
                    <li
                      class:list={[
                        'flex items-start',
                        !isEven && 'md:flex-row-reverse',
                      ]}
                    >
                      <span
                        class:list={[
                          'text-[#bf3a2b]',
                          isEven
                            ? 'mr-3'
                            : 'ml-0 md:ml-3 mr-3 md:mr-0',
                        ]}
                      >
                        •
                      </span>
                      <span>{bullet}</span>
                    </li>
                  ))}
                </ul>

                <!-- Japanese Bullets -->
                <ul class='lang-ja space-y-3 text-sm font-normal leading-relaxed text-[#5a5252]'>
                  {item.bulletsJa.map((bullet) => (
                    <li
                      class:list={[
                        'flex items-start',
                        !isEven && 'md:flex-row-reverse',
                      ]}
                    >
                      <span
                        class:list={[
                          'text-[#bf3a2b]',
                          isEven
                            ? 'mr-3'
                            : 'ml-0 md:ml-3 mr-3 md:mr-0',
                        ]}
                      >
                        •
                      </span>
                      <span>{bullet}</span>
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          );
        })
      }
    </div>
  </div>
</section>
