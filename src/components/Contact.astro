---
import { translations } from '../i18n/translations';
const { contact } = translations;
---

<section
  class='max-w-4xl mx-auto py-32 border-t border-[#8c8484]/10 text-center'
  id='contact'
>
  <div class='flex flex-col items-center'>
    <div class='hanko-large mb-12 shadow-sm'>
      <span class='text-base font-semibold'>{contact.hanko}</span>
    </div>
    <h2
      class='text-4xl md:text-5xl serif-thin mb-6 min-h-12 md:min-h-14 flex items-center justify-center'
    >
      <span class='lang-en'>{contact.title.en}</span>
      <span class='lang-ja'>{contact.title.ja}</span>
    </h2>
    <p
      class='text-[#5a5252] font-normal max-w-md mx-auto mb-16 leading-relaxed min-h-[3.5rem] flex items-center justify-center'
    >
      <span class='lang-en'>{contact.description.en}</span>
      <span class='lang-ja'>{contact.description.ja}</span>
    </p>
    <div class='space-y-12'>
      <a
        class='group inline-flex flex-col items-center no-underline'
        href='mailto:j.perezurrutia@gmail.com'
      >
        <span
          class='text-2xl md:text-3xl font-light text-[#2d2a2a] group-hover:text-[#bf3a2b] transition-colors duration-500 tracking-tight'
        >
          j.perezurrutia@<span
            class='font-medium group-hover:tracking-widest transition-all'
            >gmail.com</span
          >
        </span>
        <div
          class='h-px w-24 bg-[#bf3a2b]/20 group-hover:w-full transition-all duration-700 mt-4'
        >
        </div>
      </a>
      <div class='flex items-center justify-center space-x-12 pt-8'>
        <a
          class='text-[#5a5252] hover:text-[#bf3a2b] transition-colors flex flex-col items-center gap-2 group w-24'
          href='https://github.com/peladno'
          target='_blank'
          rel='noopener noreferrer'
        >
          <span
            class='material-symbols-outlined text-2xl group-hover:scale-110 transition-transform'
            >code</span
          >
          <span
            class='text-[9px] uppercase tracking-[0.2em] font-medium text-center'
            >{contact.github}</span
          >
        </a>
        <a
          class='text-[#5a5252] hover:text-[#bf3a2b] transition-colors flex flex-col items-center gap-2 group w-24'
          href='https://www.linkedin.com/in/javier-perez-u/'
          target='_blank'
          rel='noopener noreferrer'
        >
          <span
            class='material-symbols-outlined text-2xl group-hover:scale-110 transition-transform'
            >groups</span
          >
          <span
            class='text-[9px] uppercase tracking-[0.2em] font-medium text-center'
            >{contact.linkedin}</span
          >
        </a>
        <a
          class='text-[#5a5252] hover:text-[#bf3a2b] transition-colors flex flex-col items-center gap-2 group w-24'
          href='/JavierCurriculum.pdf'
          target='_blank'
          rel='noopener noreferrer'
        >
          <span
            class='material-symbols-outlined text-2xl group-hover:scale-110 transition-transform'
            >description</span
          >
          <span
            class='text-[9px] uppercase tracking-[0.2em] font-medium text-center'
          >
            <span class='lang-en'>{contact.cvPdf.en}</span>
            <span class='lang-ja'>{contact.cvPdf.ja}</span>
          </span>
        </a>
      </div>
    </div>
  </div>
</section>

<!-- Aesthetic Elements -->
<div class='mt-24 flex justify-center opacity-10 py-12'>
  <div class='grid grid-cols-3 gap-8'>
    <div class='w-16 h-16 border border-[#2d2a2a] rounded-full'></div>
    <div
      class='w-16 h-16 border border-[#2d2a2a] rounded-full flex items-center justify-center'
    >
      <div class='w-2 h-2 bg-[#bf3a2b] rounded-full'></div>
    </div>
    <div class='w-16 h-16 border border-[#2d2a2a] rounded-full'></div>
  </div>
</div>
