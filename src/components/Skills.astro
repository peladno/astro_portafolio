---
const skillGroups = [
  {
    title: 'Languages',
    skills: [
      { icon: 'code', name: 'TypeScript' },
      { icon: 'bolt', name: 'C' },
      { icon: 'terminal', name: 'Python' },
    ],
  },
  {
    title: 'Frameworks',
    skills: [
      { icon: 'layers', name: 'React / Next.js' },
      { icon: 'palette', name: 'Tailwind CSS' },
      { icon: 'api', name: 'Node.js / Express' },
    ],
  },
  {
    title: 'Ecosystem',
    wide: true,
    skills: [
      { icon: 'cloud_queue', name: 'AWS Infrastructure' },
      { icon: 'inventory_2', name: 'Docker & K8s' },
      { icon: 'account_tree', name: 'Git Architecture' },
    ],
  },
];
---

<section
  class='max-w-4xl mx-auto py-24 border-t border-[#8c8484]/10'
  id='skills'
>
  <div class='grid grid-cols-1 md:grid-cols-12 gap-12'>
    <div class='md:col-span-4'>
      <h2
        class='text-xs tracking-[0.4em] uppercase text-[#bf3a2b] font-bold mb-8 flex items-center'
      >
        <span class='mr-4'>02</span> Skills
      </h2>
    </div>
    <div class='md:col-span-8'>
      <div class='grid grid-cols-1 md:grid-cols-2 gap-x-12 gap-y-16'>
        {
          skillGroups.map((group) => (
            <div class:list={['space-y-6', group.wide && 'md:col-span-2']}>
              <h3 class='text-[10px] tracking-[0.2em] uppercase font-bold text-[#8c8484]'>
                {group.title}
              </h3>
              <ul
                class:list={[
                  'text-sm font-light',
                  group.wide
                    ? 'flex flex-wrap gap-x-12 gap-y-4'
                    : 'space-y-4',
                ]}
              >
                {group.skills.map((skill) => (
                  <li class='flex items-center space-x-3'>
                    <span class='material-symbols-outlined text-[#bf3a2b] text-lg'>
                      {skill.icon}
                    </span>
                    <span>{skill.name}</span>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>
