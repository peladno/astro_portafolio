---
import { translations } from '../i18n/translations';
const { projects } = translations;
---

<section
  class='max-w-4xl mx-auto py-24 border-t border-[#8c8484]/10'
  id='projects'
>
  <div class='grid grid-cols-1 md:grid-cols-12 gap-12 mb-16'>
    <div class='md:col-span-4'>
      <h2
        class='text-xs tracking-[0.4em] uppercase text-[#bf3a2b] font-bold flex items-center mb-8'
      >
        <span class='mr-4'>{projects.sectionNum}</span>
        <span class='lang-en'>{projects.sectionTitle.en}</span>
        <span class='lang-ja'>{projects.sectionTitle.ja}</span>
      </h2>
    </div>
  </div>

  <div class='grid grid-cols-1 md:grid-cols-2 gap-16 md:gap-24'>
    {
      projects.items.map((project) => (
        <div class='group flex flex-col justify-between h-full'>
          <div class='flex flex-col flex-grow'>
            <div class='relative overflow-hidden mb-8 aspect-video bg-neutral-200 border border-[#8c8484]/20 rounded-sm shadow-sm'>
              <img
                alt={project.nameEn}
                class='w-full h-full object-cover object-top grayscale-0 md:grayscale md:group-hover:grayscale-0 transition-all duration-700'
                src={project.img}
                loading='lazy'
              />
              <div class='absolute inset-0 border border-[#bf3a2b]/0 group-hover:border-[#bf3a2b]/20 transition-all pointer-events-none' />
              <div class='absolute top-4 right-4 text-[9px] uppercase tracking-widest bg-white/90 px-3 py-1 text-[#bf3a2b] font-bold shadow-sm min-w-[92px] text-center'>
                <span class='lang-en'>
                  {projects.caseStudy.en} {project.caseNumber}
                </span>
                <span class='lang-ja'>
                  {projects.caseStudy.ja} {project.caseNumber}
                </span>
              </div>
            </div>

            <div class='space-y-4 flex flex-col flex-grow'>
              <div class='flex flex-wrap gap-2 min-h-[1.75rem]'>
                {project.skills.map((skill) => (
                  <span class='text-[9px] uppercase tracking-widest border border-[#8c8484]/40 px-2 py-0.5 text-[#5a5252] font-medium'>
                    {skill}
                  </span>
                ))}
              </div>
              <h4 class='text-2xl serif-thin min-h-[2rem] flex items-center text-[#2d2a2a]'>
                <span class='lang-en'>{project.nameEn}</span>
                <span class='lang-ja'>{project.nameJa}</span>
              </h4>
              <p class='text-sm font-normal leading-relaxed text-[#5a5252] min-h-[4rem]'>
                <span class='lang-en'>{project.descriptionEn}</span>
                <span class='lang-ja'>{project.descriptionJa}</span>
              </p>
            </div>
          </div>

          <div class='flex items-center gap-6 pt-6 mt-4 border-t border-[#8c8484]/10 min-h-[3rem]'>
            {project.web && (
              <a
                class='inline-flex items-center text-[10px] uppercase tracking-[0.2em] font-bold text-[#bf3a2b] hover:translate-x-1 transition-transform'
                href={project.web}
                target='_blank'
                rel='noopener noreferrer'
              >
                <span class='lang-en'>{projects.liveDemo.en}</span>
                <span class='lang-ja'>{projects.liveDemo.ja}</span>
                <span class='material-symbols-outlined ml-1.5 text-sm'>
                  open_in_new
                </span>
              </a>
            )}
            {project.github && (
              <a
                class='inline-flex items-center text-[10px] uppercase tracking-[0.2em] font-bold text-[#5a5252] hover:text-[#2d2a2a] hover:translate-x-1 transition-transform'
                href={project.github}
                target='_blank'
                rel='noopener noreferrer'
              >
                <span class='lang-en'>{projects.sourceCode.en}</span>
                <span class='lang-ja'>{projects.sourceCode.ja}</span>
                <span class='material-symbols-outlined ml-1.5 text-sm'>
                  code
                </span>
              </a>
            )}
          </div>
        </div>
      ))
    }
  </div>
</section>
