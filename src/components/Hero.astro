---
import { translations } from '../i18n/translations';
const { hero } = translations;
---

<section
  class='max-w-4xl mx-auto flex flex-col md:flex-row items-center md:items-start justify-between min-h-[70vh] mb-16 sm:mb-20 md:mb-32 pt-28 sm:pt-32 md:pt-32'
  id='home'
>
  <!-- Text Column -->
  <div class='w-full md:w-2/3 order-2 md:order-1 mt-3 sm:mt-4 md:mt-0'>
    <div class='mb-3 md:mb-6 opacity-90'>
      <span class='hanko text-xs'>{hero.seal}</span>
    </div>
    <h1
      class='text-5xl sm:text-6xl md:text-8xl serif-thin leading-tight mb-3 md:mb-4 text-[#2d2a2a]'
    >
      {hero.firstName}
      <br />
      <span class='italic ml-4 sm:ml-8 md:ml-16'>{hero.lastName}</span>
    </h1>
    <div class='flex items-center space-x-3 sm:space-x-4 mt-4 md:mt-8'>
      <div class='h-px w-8 sm:w-12 bg-[#bf3a2b]'></div>
      <p
        class='text-xs sm:text-sm tracking-[0.2em] sm:tracking-[0.25em] md:tracking-[0.3em] uppercase text-[#8c8484] font-light'
      >
        <span class='lang-en'>{hero.role.en}</span>
        <span class='lang-ja'>{hero.role.ja}</span>
      </p>
    </div>
    <div class='mt-8 sm:mt-12 md:mt-24 max-w-sm'>
      <p class='text-sm font-light italic text-[#8c8484] leading-relaxed'>
        <span class='lang-en'>{hero.quote.en}</span>
        <span class='lang-ja'>{hero.quote.ja}</span>
      </p>
    </div>
  </div>

  <!-- Profile Image Column (Shown at top on mobile with balanced spacing) -->
  <div
    class='w-full md:w-1/3 order-1 md:order-2 flex justify-center md:justify-end mb-3 md:mb-0'
  >
    <div class='relative group'>
      <div
        class='absolute -inset-3 md:-inset-4 border border-[#bf3a2b]/20 rounded-full transition-all group-hover:inset-0'
      >
      </div>
      <div
        class='w-36 h-36 sm:w-48 sm:h-48 md:w-64 md:h-64 rounded-full overflow-hidden border-4 border-[#f8f6f6] shadow-2xl grayscale hover:grayscale-0 transition-all duration-700'
      >
        <img
          alt={hero.portraitAlt.en}
          class='w-full h-full'
          src='/images/profile.jpg'
        />
      </div>
      <div
        class='absolute bottom-1 -right-1 sm:bottom-2 sm:-right-2 md:bottom-4 md:-right-4 bg-[#bf3a2b] text-white text-[9px] sm:text-[10px] py-1 px-2.5 sm:py-1.5 sm:px-3 md:py-2 md:px-4 rounded-full tracking-widest uppercase font-medium shadow-sm'
      >
        <span class='lang-en'>{hero.available.en}</span>
        <span class='lang-ja'>{hero.available.ja}</span>
      </div>
    </div>
  </div>
</section>
